---
const repoUrl = 'https://github.com/shannoncarver/hackathon-may-2026';
---

<footer class="site-footer">
  <div class="container wide">
    <p>
      LINQ Hackathon · May 2026 · The Forge: Season 2 — Every Minute Matters
      <span class="sep" aria-hidden="true">·</span>
      <a href={repoUrl}>Source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 24px 0 32px;
    color: var(--color-text-muted);
    font-size: 14px;
    background: var(--color-surface);
    margin-top: 64px;
  }
  .site-footer p { margin: 0; }
  .site-footer .sep { margin: 0 8px; color: var(--color-text-subtle); }
  .site-footer a { color: var(--color-primary); }
</style>
