---
interface DocItem {
  href: string;
  title: string;
  path?: string;
  description: string;
}

interface Props {
  items: DocItem[];
}

const { items } = Astro.props;
---

<div class="doc-list">
  {items.map((doc) => (
    <a href={doc.href} class="doc">
      <div class="title">
        {doc.title}
        {doc.path && <code>{doc.path}</code>}
      </div>
      <p class="desc">{doc.description}</p>
    </a>
  ))}
</div>

<style>
  .doc-list {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 8px 0;
    margin: 20px 0 32px;
  }
  .doc-list .doc {
    display: block;
    padding: 16px 24px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .doc-list .doc:last-child { border-bottom: none; }
  .doc-list .doc:hover {
    background: var(--color-surface-alt);
    text-decoration: none;
  }
  .doc-list .title {
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 4px;
  }
  .doc-list .title code {
    font-size: 0.85em;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-left: 8px;
  }
  .doc-list .desc {
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
