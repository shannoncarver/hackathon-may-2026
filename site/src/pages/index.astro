---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PersonaPivot from '../components/PersonaPivot.astro';
import PersonaBand from '../components/PersonaBand.astro';
import OutcomeCard from '../components/OutcomeCard.astro';
import PrimaryCard from '../components/PrimaryCard.astro';

const baseUrl = import.meta.env.BASE_URL;
const join = (path: string) => `${baseUrl.replace(/\/$/, '')}${path}`;

// All five hackathon outcomes. The Featured section below is the canonical gallery;
// persona bands offer tailored CTAs that route into one outcome each.
const outcomes = [
  {
    href: join('/outcomes/knowledge-wiki/'),
    pillar: 'Knowledge base',
    status: 'shipped' as const,
    title: 'Three-layer LLM-wiki for project knowledge',
    summary: 'Karpathy-style raw / wiki / SCHEMA pattern. Immutable sources, LLM-curated synthesis, audit-friendly provenance.',
  },
  {
    href: join('/outcomes/agent-roster/'),
    pillar: 'Agent definitions',
    status: 'shipped' as const,
    title: 'Coordinator and nine specialist sub-agents',
    summary: 'A primary coordinator routes work to nine domain specialists with versioned JSON-schema I/O contracts.',
  },
  {
    href: join('/outcomes/centralized-mcp/'),
    pillar: 'MCP connectors',
    status: 'in-progress' as const,
    title: 'Centralized platform MCP design',
    summary: 'A single internal MCP server fronts LINQ products. IdentityBroker token exchange, audit trail, drift control.',
  },
  {
    href: join('/outcomes/aws-skill-credentials/'),
    pillar: 'Skills management',
    status: 'shipped' as const,
    title: 'AWS multi-account skill credentials',
    summary: 'Named profiles, environment-derived defaults, prod-acknowledgment guard, sts:GetCallerIdentity audit banner.',
  },
  {
    href: join('/outcomes/eval-harness/'),
    pillar: 'Quality',
    status: 'in-progress' as const,
    title: 'Eval harness — Inspect-AI per-agent and end-to-end',
    summary: 'Per-agent and e2e tests with a code-quality judge rubric. Reports land in evals/reports/.',
  },
];
---

<BaseLayout title="Home">
  <div class="container wide">
    <Hero
      eyebrow="The Forge · Season 2"
      title="LINQ Hackathon — Every Minute Matters"
      lede="A coordinator-and-specialists Claude Code system that routes engineering, product, documentation, and knowledge-management work to versioned sub-agents. This site captures what we built, what we learned, and what's next."
    >
      <PersonaPivot />
    </Hero>

    <section class="featured" aria-labelledby="featured-title">
      <h2 id="featured-title">Outcomes</h2>
      <p class="muted">Five threads from the hackathon. Each card lands on a TL;DR, an Overview, and a Deep dive with linked sources for every claim.</p>
      <div class="outcome-grid">
        {outcomes.map((o) => (
          <OutcomeCard href={o.href} pillar={o.pillar} status={o.status} title={o.title} summary={o.summary} />
        ))}
      </div>
    </section>
  </div>

  <PersonaBand
    id="exec"
    eyebrow="Path · Executive"
    title="If you have 60 seconds"
    description="What we built, what came of it, and what we would productionize. No code, no jargon."
    goDeeperHref={join('/outcomes/')}
    goDeeperLabel="See all outcomes"
  >
    <PrimaryCard
      href={join('/outcomes/agent-roster/')}
      label="Start here"
      title="Coordinator and nine specialist sub-agents"
      description="The structural bet of the hackathon — one coordinator routes plain-English requests to specialists with versioned contracts. Read this one first."
      cta="Read the outcome →"
    />
  </PersonaBand>

  <PersonaBand
    id="pm"
    eyebrow="Path · Product"
    title="Use cases and what shipped"
    description="The user journeys we proved out and the things worth productionizing next."
    goDeeperHref={join('/tutorials/incident-triage/')}
    goDeeperLabel="See the chain in action"
  >
    <PrimaryCard
      href={join('/tutorials/incident-triage/')}
      label="Worked example"
      title="Incident triage — five skills in one chain"
      description="A realistic LINQ incident resolved in roughly four minutes. Auth0 events, AWS-side state, ERP authorization, then the resolution back into the wiki for the next on-call."
      cta="Walk the chain →"
    />
  </PersonaBand>

  <PersonaBand
    id="builder"
    eyebrow="Path · Engineering"
    title="Architecture, decisions, and code"
    description="Sub-agent definitions, JSON-schema I/O contracts, MCP wiring, evals, and the 16 architecture-decision records that explain how we got here."
    goDeeperHref={join('/decisions/')}
    goDeeperLabel="Browse decisions"
  >
    <PrimaryCard
      href={join('/how-it-works/')}
      label="Architecture"
      title="How the coordinator routes work"
      description="Walk the six pillars — knowledge base, repo structure, documentation, agent definitions, skills management, and MCP connectors."
      cta="Open architecture →"
    />
  </PersonaBand>

  <PersonaBand
    id="curious"
    eyebrow="Path · Curious"
    title="What is this and why?"
    description="A LINQ-internal hackathon entry exploring whether a coordinator-plus-specialists Claude Code setup is a force multiplier across engineering, product, support, and knowledge management."
    goDeeperHref={join('/about/')}
    goDeeperLabel="About this project"
  >
    <PrimaryCard
      href={join('/about/')}
      label="About"
      title="The Forge: Season 2 — Every Minute Matters"
      description="What we set out to prove, who built it, and how this repository is organized."
      cta="Read about →"
    />
  </PersonaBand>
</BaseLayout>

<style>
  .featured { padding: 16px 0 8px; }
  .featured h2 { margin-top: 24px; }
  .featured .muted { color: var(--color-text-muted); margin: 0 0 24px; }
  .outcome-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
</style>
