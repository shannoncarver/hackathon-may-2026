---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';

const baseUrl = import.meta.env.BASE_URL;
const join = (path: string) => `${baseUrl.replace(/\/$/, '')}${path}`;
---

<ArticleLayout
  title="Incident triage — five skills in one chain"
  description="Walk a realistic LINQ incident from suspicious failed logins to a closed case, then back into the wiki for the next on-call."
  eyebrow="Combined workflow"
  lede="The page that turns a list of skills into a system. Each step produces structured evidence the operator and coordinator carry into the next; the chain is what makes the whole greater than its parts."
  breadcrumb={[
    { label: 'Home', href: join('/') },
    { label: 'Tutorials', href: join('/tutorials/') },
    { label: 'Incident triage' },
  ]}
>
  <Callout variant="info" label="TL;DR">
    <ul>
      <li>One incident, five skills, roughly four minutes.</li>
      <li>Each skill produces structured evidence the operator carries into the next.</li>
      <li>The coordinator routes — one engineer typed plain-English prompts; no Lucene query, no Python invocation, and no DynamoDB table name was ever typed by hand.</li>
    </ul>
  </Callout>

  <figure>
