# Copy to ha-debug/.env and fill in. Never commit .env.

# AWS — omit if using IAM role / SSO (SDK picks up credentials automatically)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# DynamoDB table names (non-production environment)
ACCOUNTS_TABLE_NAME=
SUPER_ADMIN_MFA_TABLE_NAME=
APP_CLIENTS_TABLE_NAME=

# Cognito
COGNITO_USER_POOL_ID=

# Auth0 Management API — needs read:users, read:logs, read:authentication_methods scopes
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# CloudWatch — exact log group name to query (typically the main auth handler)
CW_LOG_GROUP_NAME=/aws/lambda/harmony-auth

# Where write-resolved-case writes (relative to cwd; defaults to knowledge/wiki/cases)
# WIKI_CASES_DIR=knowledge/wiki/cases
