# Secrets — never commit
.env
.env.local

# Local Claude Code overrides
.claude/settings.local.json
.mcp.local.json

# Git worktrees managed by Claude Code (not part of the project tree)
.claude/worktrees/

# Runtime artifacts (ignore contents but keep the directories themselves)
traces/*
output/*
evals/reports/*
!traces/.gitkeep
!output/.gitkeep
!evals/reports/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Editor
.DS_Store
.idea/
.vscode/
