{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linq.com/hackathon-may-2026/schemas/agents/18-eng-product-handler.schema.json",
  "title": "Product Handler Owner Output Contract",
  "description": "Output schema for the eng-product-handler sub-agent. Coordinator validates every response against this schema.",
  "type": "object",
  "required": ["contract_version", "summary", "verdict", "deliverables", "handler_code_skeleton", "mock_data", "iam_exec_role", "jwt_verify_strategy", "contract_tests", "onboarding_steps", "risks_addressed", "open_questions", "references"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "verdict": { "enum": ["approve", "approve-with-changes", "request-changes"] },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "enum": ["handler-code", "schema", "fixture", "doc", "other"] }
        }
      }
    },
    "handler_code_skeleton": {
      "type": "object",
      "required": ["tool_id", "language", "sdk_version", "input_schema_path", "output_schema_path", "code"],
      "additionalProperties": false,
      "properties": {
        "tool_id": { "type": "string", "description": "e.g., erp.checkUserAccess" },
        "language": { "enum": ["typescript", "python", "javascript"] },
        "sdk_version": { "type": "string" },
        "input_schema_path": { "type": "string" },
        "output_schema_path": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "mock_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "rows"],
        "additionalProperties": false,
        "properties": {
          "entity": { "type": "string" },
          "rows": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "iam_exec_role": {
      "type": "object",
      "required": ["role_name", "policy_json", "scope_summary"],
      "additionalProperties": false,
      "properties": {
        "role_name": { "type": "string" },
        "policy_json": { "type": "string" },
        "scope_summary": { "type": "string", "description": "Plain-English description of what the role can do — one short sentence." }
      }
    },
    "jwt_verify_strategy": {
      "type": "object",
      "required": ["jwks_url", "kid_handling", "tenant_source_claim"],
      "additionalProperties": false,
      "properties": {
        "jwks_url": { "type": "string" },
        "kid_handling": { "type": "string" },
        "tenant_source_claim": { "type": "string", "description": "JWT claim path the handler reads tenant_id from (NEVER args)." },
        "cache_ttl_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "contract_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "subject"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "subject": { "type": "string" }
        }
      }
    },
    "onboarding_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "actor", "action"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "actor": { "enum": ["product-team", "platform-team", "ci"] },
          "action": { "type": "string" }
        }
      }
    },
    "risks_addressed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "how"],
        "additionalProperties": false,
        "properties": {
          "risk_id": { "type": "string", "pattern": "^R\\d{1,2}$" },
          "how": { "type": "string" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "blocking", "forced_today"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "blocking": { "type": "boolean" },
          "forced_today": { "type": "string" }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "relevance"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "relevance": { "type": "string" }
        }
      }
    }
  }
}
