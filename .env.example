# Copy to .env and fill in. Never commit .env.

# Anthropic API — required for evals/run.py
ANTHROPIC_API_KEY=sk-ant-...

# Atlassian MCP server (.mcp.json)
# Per-user OAuth on first invocation — no secret to commit here.
# Token is managed by the Atlassian MCP client.

# GitHub MCP server (added in a follow-up PR; placeholder here)
# GITHUB_TOKEN=ghp_...

# Auth0 Management API — sandbox tenant
# Create an M2M app in Auth0 Dashboard with read:logs scope.
# See docs/developer/onboarding.md for setup instructions.
# (For LINQ developers: the sandbox tenant is linq-accounts-sandbox.us.auth0.com)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
